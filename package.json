{
  "name": "electronics-shop-crm",
  "version": "1.0.3",
  "description": "Modern Fashion Bazaar - Point of Sale & Inventory Management",
  "main": "src/main/index.js",
  "homepage": "./",
  "author": "Shadab",
  "license": "PROPRIETARY",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && node scripts/start-electron.js",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.0.0",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.1.1",
    "exceljs": "^4.4.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@reduxjs/toolkit": "^1.9.7",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.electronicsshopcrm.app",
    "productName": "Modern Fashion Bazaar",
    "npmRebuild": false,
    "files": [
      "src/main/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "publish": {
      "provider": "github",
      "owner": "shadabalam2024",
      "repo": "Modern-Fashion-Bazaar-Electronics-App"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
